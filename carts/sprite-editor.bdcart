// @title  Sprite Editor
// @author Bidule samples
// @id     sprite-editor

// Edits the tile sheet of any cart on the shelf.
// Tap B to move between panels: canvas, sheet, palette, tools.
// B + left/right: colour   B + up/down: tile   B + A: undo
// The mouse works everywhere: click to draw, pick and choose.

enum Focus { CANVAS, SHEET, PALETTE, TOOLS }
enum Tool { PEN, FILL, PICK }

const Z = 11
const CX = 6
const CY = 16
const PVX = 104
const PVY = 16
const PALX = 104
const PALY = 44
const TOOLX = 104
const TOOLY = 68
const FLAGX = 104
const FLAGY = 98
const SHX = 6
const SHY = 116
const SHCOLS = 16
const SHROWS = 4
const PITCH = 9
const BG = DARK_BLUE

const TOOL_NAMES[6][4] = {
  "PEN ",
  "FILL",
  "PICK",
  "UNDO",
  "OPEN",
  "SAVE",
}

var h = -1
var px[65]
var und[65]
var tmp[65]
var stk[64]
var tile = 0
var cx = 0
var cy = 0
var colour = 7
var tool = Tool.PEN
var focus = Focus.CANVAS
var toolsel = 0
var dirty = 0
var unsaved = 0
var open_armed = 0
var wx = 0
var wy = 0
var held[4]
var rp[4]
var bdown = 0
var bused = 0
var mprev = 0
var redraw_all = 1
var redraw_sheet = 1
var thumb = 0
var seldrawn = -1
var msg[48]
var msgtime = 0

// ---------- tiles ----------

fn load() {
  readasset(h, px, tile)
  copy(und, px)
  dirty = 0
}

fn keep() {
  if (dirty) {
    writeasset(h, px, tile)
    dirty = 0
    unsaved = 1
  }
}

fn select(t) {
  t = (t + 1024) % 1024
  if (t == tile) { return }
  keep()
  tile = t
  load()
  var col = tile % 32
  var row = tile / 32
  var nwx = (col / SHCOLS) * SHCOLS
  var nwy = wy
  if (row < wy) { nwy = row }
  if (row >= wy + SHROWS) { nwy = row - SHROWS + 1 }
  if (nwx != wx || nwy != wy) {
    wx = nwx
    wy = nwy
    redraw_sheet = 1
  }
}

fn scroll(dr, side) {
  wy = clamp(wy + dr, 0, 32 - SHROWS)
  if (side) { wx = SHCOLS - wx }
  redraw_sheet = 1
}

// ---------- drawing on the tile ----------

fn setpx(x, y, c) {
  if (px[y * 8 + x] != c) {
    px[y * 8 + x] = c
    dirty = 1
    thumb = 1
  }
}

fn fill(x, y) {
  var target = px[y * 8 + x]
  if (target == colour) { return }
  var n = 1
  stk[0] = y * 8 + x
  px[y * 8 + x] = colour
  while (n > 0) {
    n--
    var p = stk[n]
    if (p % 8 > 0 && px[p - 1] == target) {
      px[p - 1] = colour
      stk[n] = p - 1
      n++
    }
    if (p % 8 < 7 && px[p + 1] == target) {
      px[p + 1] = colour
      stk[n] = p + 1
      n++
    }
    if (p >= 8 && px[p - 8] == target) {
      px[p - 8] = colour
      stk[n] = p - 8
      n++
    }
    if (p < 56 && px[p + 8] == target) {
      px[p + 8] = colour
      stk[n] = p + 8
      n++
    }
  }
  dirty = 1
  thumb = 1
}

fn begin() {
  if (tool != Tool.PICK) { copy(und, px) }
}

fn apply(x, y, pressed) {
  switch (tool) {
    Tool.PEN { setpx(x, y, colour) }
    Tool.FILL {
      if (pressed) { fill(x, y) }
    }
    Tool.PICK {
      if (pressed) {
        colour = px[y * 8 + x]
        tool = Tool.PEN
      }
    }
  }
}

fn undo() {
  copy(tmp, px)
  copy(px, und)
  copy(und, tmp)
  dirty = 1
  thumb = 1
}

// ---------- cart ----------

fn open() {
  var picked = pickcart("tiles")
  redraw_all = 1
  if (picked < 0) {
    fmt(msg, "No cart opened")
    msgtime = 180
    return
  }
  h = picked
  tile = 0
  wx = 0
  wy = 0
  unsaved = 0
  load()
  fmt(msg, "Editing {assetcount(h)} tiles")
  msgtime = 180
}

fn save() {
  keep()
  if (savecart(h)) {
    unsaved = 0
    fmt(msg, "Saved")
  } else {
    fmt(msg, "Not saved")
  }
  msgtime = 180
  redraw_all = 1
}

fn act(i) {
  if (i != 4) { open_armed = 0 }
  if (i < 3) {
    tool = i
    return
  }
  if (i == 3) {
    undo()
    return
  }
  if (i == 4) {
    if ((unsaved || dirty) && !open_armed) {
      open_armed = 1
      fmt(msg, "Unsaved! OPEN again to discard")
      msgtime = 240
      return
    }
    open_armed = 0
    open()
    return
  }
  if (i == 5) {
    save()
    return
  }
  px[64] = px[64] ^ (1 << (i - 6))
  dirty = 1
}

// ---------- input ----------

fn rep(b) {
  if (btn(b)) {
    held[b]++
    return held[b] == 1 || (held[b] > 12 && held[b] % 4 == 0)
  }
  held[b] = 0
  return 0
}

fn navigate() {
  switch (focus) {
    Focus.CANVAS {
      if (rp[BTN_LEFT])  { cx = (cx + 7) % 8 }
      if (rp[BTN_RIGHT]) { cx = (cx + 1) % 8 }
      if (rp[BTN_UP])    { cy = (cy + 7) % 8 }
      if (rp[BTN_DOWN])  { cy = (cy + 1) % 8 }
      if (btnp(BTN_A)) { begin() }
      if (btn(BTN_A)) { apply(cx, cy, btnp(BTN_A)) }
    }
    Focus.SHEET {
      if (rp[BTN_LEFT])  { select(tile - 1) }
      if (rp[BTN_RIGHT]) { select(tile + 1) }
      if (rp[BTN_UP])    { select(tile - 32) }
      if (rp[BTN_DOWN])  { select(tile + 32) }
      if (btnp(BTN_A)) { focus = Focus.CANVAS }
    }
    Focus.PALETTE {
      if (rp[BTN_LEFT])  { colour = (colour + 15) % 16 }
      if (rp[BTN_RIGHT]) { colour = (colour + 1) % 16 }
      if (rp[BTN_UP] || rp[BTN_DOWN]) { colour = (colour + 8) % 16 }
      if (btnp(BTN_A)) { focus = Focus.CANVAS }
    }
    Focus.TOOLS {
      if (rp[BTN_LEFT])  { toolsel = (toolsel + 13) % 14 }
      if (rp[BTN_RIGHT]) { toolsel = (toolsel + 1) % 14 }
      if (rp[BTN_UP]) {
        if (toolsel >= 6) {
          toolsel = 3
        } else {
          toolsel = (toolsel + 3) % 6
        }
      }
      if (rp[BTN_DOWN]) {
        if (toolsel >= 3 && toolsel < 6) {
          toolsel = 6
        } else if (toolsel < 3) {
          toolsel = toolsel + 3
        } else {
          toolsel = 0
        }
      }
      if (btnp(BTN_A)) { act(toolsel) }
    }
  }
}

fn inside(x, y, rx, ry, rw, rh) {
  return x >= rx && y >= ry && x < rx + rw && y < ry + rh
}

fn mouse() {
  if (!haspointer()) { return }
  var b = mouseb() & 1
  var pressed = b && !mprev
  mprev = b
  if (!b) { return }
  var mx = mousex()
  var my = mousey()
  if (inside(mx, my, CX, CY, 8 * Z, 8 * Z)) {
    cx = (mx - CX) / Z
    cy = (my - CY) / Z
    focus = Focus.CANVAS
    if (pressed) { begin() }
    apply(cx, cy, pressed)
    return
  }
  if (!pressed) { return }
  if (inside(mx, my, PALX, PALY, 88, 18)) {
    colour = (my - PALY) / 9 * 8 + (mx - PALX) / 11
    focus = Focus.PALETTE
  } else if (inside(mx, my, TOOLX, TOOLY, 132, 26)) {
    toolsel = (my - TOOLY) / 13 * 3 + (mx - TOOLX) / 44
    focus = Focus.TOOLS
    act(toolsel)
  } else if (inside(mx, my, FLAGX + 36, FLAGY, 80, 9)) {
    toolsel = 6 + (mx - FLAGX - 36) / 10
    focus = Focus.TOOLS
    act(toolsel)
  } else if (inside(mx, my, SHX, SHY, SHCOLS * PITCH, SHROWS * PITCH)) {
    focus = Focus.SHEET
    select((wy + (my - SHY) / PITCH) * 32 + wx + (mx - SHX) / PITCH)
  } else if (inside(mx, my, 156, 128, 24, 11)) {
    scroll(-SHROWS, 0)
  } else if (inside(mx, my, 182, 128, 24, 11)) {
    scroll(SHROWS, 0)
  } else if (inside(mx, my, 208, 128, 24, 11)) {
    scroll(0, 1)
  }
}

// ---------- lifecycle ----------

init() {
  open()
}

update() {
  for (var b = 0; b < 4; b++) {
    rp[b] = rep(b)
  }
  if (msgtime > 0) { msgtime-- }
  if (h < 0) {
    if (btnp(BTN_A)) { open() }
    mouse()
    bdown = btn(BTN_B)
    return
  }
  if (btn(BTN_B)) {
    if (btnp(BTN_B)) { bused = 0 }
    if (rp[BTN_LEFT]) {
      colour = (colour + 15) % 16
      bused = 1
    }
    if (rp[BTN_RIGHT]) {
      colour = (colour + 1) % 16
      bused = 1
    }
    if (rp[BTN_UP]) {
      select(tile - 1)
      bused = 1
    }
    if (rp[BTN_DOWN]) {
      select(tile + 1)
      bused = 1
    }
    if (btnp(BTN_A)) {
      undo()
      bused = 1
    }
  } else {
    if (bdown && !bused) { focus = (focus + 1) % 4 }
    navigate()
  }
  mouse()
  bdown = btn(BTN_B)
}

// ---------- drawing ----------

fn draw_tile(t, x, y) {
  if (t == tile) {
    copy(tmp, px)
  } else {
    readasset(h, tmp, t)
  }
  for (var j = 0; j < 8; j++) {
    for (var i = 0; i < 8; i++) {
      pset(x + i, y + j, tmp[j * 8 + i])
    }
  }
}

fn mark(t, c) {
  var col = t % 32 - wx
  var row = t / 32 - wy
  if (col >= 0 && col < SHCOLS && row >= 0 && row < SHROWS) {
    rect(SHX + col * PITCH - 1, SHY + row * PITCH - 1, 10, 10, c)
  }
}

fn draw_sheet() {
  rectfill(SHX - 2, SHY - 2, SHCOLS * PITCH + 3, SHROWS * PITCH + 3, BLACK)
  for (var r = 0; r < SHROWS; r++) {
    for (var c = 0; c < SHCOLS; c++) {
      draw_tile((wy + r) * 32 + wx + c, SHX + c * PITCH, SHY + r * PITCH)
    }
  }
  seldrawn = -1
  redraw_sheet = 0
  thumb = 0
}

fn draw_static() {
  cls(BG)
  rectfill(0, 0, SCREEN_W, 11, BLACK)
  print("SPRITE EDITOR", 3, 1, YELLOW)
  rectfill(CX - 2, CY - 2, 8 * Z + 3, 8 * Z + 3, BLACK)
  print("COLOUR", PALX, PALY - 10, GREY)
  print("FLAGS", FLAGX, FLAGY + 1, GREY)
  rectfill(156, 128, 24, 11, DARK_GREY)
  rectfill(182, 128, 24, 11, DARK_GREY)
  rectfill(208, 128, 24, 11, DARK_GREY)
  print("UP", 162, 129, WHITE)
  print("DN", 188, 129, WHITE)
  print("<>", 214, 129, WHITE)
  redraw_sheet = 1
  redraw_all = 0
}

fn frame_around(x, y, w, hh, on) {
  rect(x, y, w, hh, on ? YELLOW : BG)
}

draw(frame) {
  if (h < 0) {
    if (redraw_all) {
      cls(BG)
      rectfill(0, 0, SCREEN_W, 11, BLACK)
      print("SPRITE EDITOR", 3, 1, YELLOW)
      redraw_all = 0
    }
    rectfill(0, 60, SCREEN_W, 40, BG)
    print("Press A to open a cart", 54, 70, WHITE)
    if (msgtime > 0) { print(msg, (SCREEN_W - textwidth(msg)) / 2, 84, ORANGE) }
    return
  }
  if (redraw_all) { draw_static() }
  if (redraw_sheet) { draw_sheet() }
  if (thumb) {
    var col = tile % 32 - wx
    var row = tile / 32 - wy
    if (col >= 0 && col < SHCOLS && row >= 0 && row < SHROWS) {
      draw_tile(tile, SHX + col * PITCH, SHY + row * PITCH)
    }
    thumb = 0
  }

  // top bar
  rectfill(120, 0, 120, 11, BLACK)
  print("TILE {tile:04}", 180, 1, WHITE)
  if (unsaved || dirty) { print("UNSAVED", 130, 1, ORANGE) }

  // canvas: clear it first so the previous cursor outline disappears
  rectfill(CX - 1, CY - 1, 8 * Z + 1, 8 * Z + 1, BLACK)
  for (var y = 0; y < 8; y++) {
    for (var x = 0; x < 8; x++) {
      rectfill(CX + x * Z, CY + y * Z, Z - 1, Z - 1, px[y * 8 + x])
    }
  }
  var blink = (frame / 10) % 2 == 0
  if (focus == Focus.CANVAS && blink) {
    rect(CX + cx * Z - 1, CY + cy * Z - 1, Z + 1, Z + 1, WHITE)
  } else {
    rect(CX + cx * Z - 1, CY + cy * Z - 1, Z + 1, Z + 1, GREY)
  }
  frame_around(CX - 4, CY - 4, 8 * Z + 7, 8 * Z + 7, focus == Focus.CANVAS)

  // previews at 1x and 2x
  rectfill(PVX - 1, PVY - 1, 28, 18, BLACK)
  for (var y = 0; y < 8; y++) {
    for (var x = 0; x < 8; x++) {
      pset(PVX + x, PVY + y, px[y * 8 + x])
      rectfill(PVX + 10 + x * 2, PVY + y * 2, 2, 2, px[y * 8 + x])
    }
  }
  rectfill(140, 14, 96, 22, BG)
  print("{tile % 32},{tile / 32} in sheet", 140, 16, GREY)
  print("Colour {colour}", 140, 26, WHITE)

  // palette
  for (var i = 0; i < 16; i++) {
    rectfill(PALX + (i % 8) * 11, PALY + (i / 8) * 9, 10, 8, i)
  }
  rect(PALX - 2, PALY - 2, 92, 22, BG)
  for (var i = 0; i < 16; i++) {
    if (i == colour) {
      rect(PALX + (i % 8) * 11 - 1, PALY + (i / 8) * 9 - 1, 12, 10, WHITE)
    } else {
      rect(PALX + (i % 8) * 11 - 1, PALY + (i / 8) * 9 - 1, 12, 10, BG)
    }
  }
  frame_around(PALX - 3, PALY - 3, 94, 24, focus == Focus.PALETTE)

  // tools
  for (var i = 0; i < 6; i++) {
    var tx = TOOLX + (i % 3) * 44
    var ty = TOOLY + (i / 3) * 13
    var bg = DARK_GREY
    if (i < 3 && i == tool) { bg = BLUE }
    rectfill(tx, ty, 42, 11, bg)
    var fg = WHITE
    if (focus == Focus.TOOLS && toolsel == i) { fg = YELLOW }
    print(TOOL_NAMES[i], tx + 9, ty + 1, fg)
    if (focus == Focus.TOOLS && toolsel == i) {
      rect(tx - 1, ty - 1, 44, 13, YELLOW)
    } else {
      rect(tx - 1, ty - 1, 44, 13, BG)
    }
  }

  // flags
  for (var i = 0; i < 8; i++) {
    var fx = FLAGX + 36 + i * 10
    var on = (px[64] >> i) & 1
    rectfill(fx, FLAGY, 9, 9, on ? ORANGE : DARK_GREY)
    print("{i}", fx + 2, FLAGY, on ? BLACK : GREY)
    if (focus == Focus.TOOLS && toolsel == 6 + i) {
      rect(fx - 1, FLAGY - 1, 11, 11, YELLOW)
    } else {
      rect(fx - 1, FLAGY - 1, 11, 11, BG)
    }
  }
  frame_around(TOOLX - 3, TOOLY - 3, 136, 45, focus == Focus.TOOLS)

  // sheet selection and info
  if (seldrawn != tile) {
    if (seldrawn >= 0) { mark(seldrawn, BLACK) }
    seldrawn = tile
  }
  if (focus == Focus.SHEET && blink) {
    mark(tile, YELLOW)
  } else {
    mark(tile, WHITE)
  }
  frame_around(SHX - 4, SHY - 4, SHCOLS * PITCH + 7, SHROWS * PITCH + 7, focus == Focus.SHEET)
  rectfill(156, 114, 80, 11, BG)
  print("ROWS {wy}-{wy + SHROWS - 1}", 156, 116, GREY)

  // status line
  rectfill(0, 151, SCREEN_W, 9, BLACK)
  if (msgtime > 0) {
    print(msg, 3, 151, ORANGE)
  } else {
    switch (focus) {
      Focus.CANVAS { print("A draw  B tap: next panel  B+A undo", 3, 151, GREY) }
      Focus.SHEET { print("Arrows: tile   A: back to canvas", 3, 151, GREY) }
      Focus.PALETTE { print("Arrows: colour   A: back to canvas", 3, 151, GREY) }
      Focus.TOOLS { print("Arrows: choose   A: use   B: next", 3, 151, GREY) }
    }
  }
}
