// @title  Sprite Editor
// @author Bidule samples
// @id     sprite-editor

// Edits the tile sheet of any cart on the shelf, and names its sprites.
// Tap B to move between panels: canvas, sheet, palette, tools.
// B + left/right: colour   B + up/down: tile   B + A: undo
// The mouse works everywhere: click to draw, pick and choose.

enum Focus { CANVAS, SHEET, PALETTE, TOOLS }
enum Tool { PEN, FILL, PICK }

const Z = 11
const CX = 6
const CY = 16
const PVX = 104
const PVY = 16
const PALX = 104
const PALY = 44
const TOOLX = 104
const TOOLY = 68
const TOOLW = 33
const FLAGX = 104
const FLAGY = 98
const SHX = 6
const SHY = 116
const SHCOLS = 16
const SHROWS = 4
const PITCH = 9
const BG = DARK_BLUE

// tools 0-6, then flags 7-14
const NTOOLS = 7
const NITEMS = 15
const TOOL_NAMES[7][4] = {
  "PEN ",
  "FILL",
  "PICK",
  "UNDO",
  "NAME",
  "OPEN",
  "SAVE",
}

// name panel: 37 characters, then DEL and OK
const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
const NCHARS = 37
const NCELLS = 39
const NPX = 14
const NPY = 22
const NCOLS = 10

var h = -1
var sh = -1
var title[17]
var px[65]
var und[65]
var tmp[65]
var rec[4]
var stk[64]
var tile = 0
var cx = 0
var cy = 0
var colour = 7
var tool = Tool.PEN
var focus = Focus.CANVAS
var toolsel = 0
var dirty = 0
var unsaved = 0
var open_armed = 0
var wx = 0
var wy = 0
var held[4]
var rp[4]
var bdown = 0
var bused = 0
var mprev = 0
var redraw_all = 1
var redraw_sheet = 1
var thumb = 0
var seldrawn = -1
var msg[48]
var msgtime = 0

// sprite name of the current tile
var sslot = -1
var sname[25]
var other[25]

// name panel
var naming = 0
var nm[25]
var nlen = 0
var nsel = 0

// ---------- messages ----------

fn say(text[]) {
  copy(msg, text)
  msgtime = 180
}

// ---------- tiles ----------

fn load() {
  readasset(h, px, tile)
  copy(und, px)
  dirty = 0
  find_sprite()
}

fn keep() {
  if (dirty) {
    writeasset(h, px, tile)
    dirty = 0
    unsaved = 1
  }
}

fn select(t) {
  t = (t + 1024) % 1024
  if (t == tile) { return }
  keep()
  tile = t
  load()
  var col = tile % 32
  var row = tile / 32
  var nwx = (col / SHCOLS) * SHCOLS
  var nwy = wy
  if (row < wy) { nwy = row }
  if (row >= wy + SHROWS) { nwy = row - SHROWS + 1 }
  if (nwx != wx || nwy != wy) {
    wx = nwx
    wy = nwy
    redraw_sheet = 1
  }
}

fn scroll(dr, side) {
  wy = clamp(wy + dr, 0, 32 - SHROWS)
  if (side) { wx = SHCOLS - wx }
  redraw_sheet = 1
}

// ---------- sprites: a name for the current tile ----------

// Finds the 1x1 sprite slot that shows the current tile.
fn find_sprite() {
  sslot = -1
  sname[0] = 0
  var n = assetcount(sh)
  for (var i = 0; i < n; i++) {
    if (readasset(sh, rec, i) == 4) {
      if (rec[0] + rec[1] * 256 == tile && rec[2] == 1 && rec[3] == 1) {
        sslot = i
        assetname(sh, i, sname)
        return
      }
    }
  }
}

fn name_taken() {
  var n = assetcount(sh)
  for (var i = 0; i < n; i++) {
    if (i != sslot) {
      assetname(sh, i, other)
      if (streq(other, nm)) { return 1 }
    }
  }
  return 0
}

fn open_naming() {
  copy(nm, sname)
  nlen = 0
  while (nm[nlen] != 0) { nlen++ }
  nsel = 0
  naming = 1
}

fn close_naming() {
  naming = 0
  redraw_all = 1
}

fn commit_name() {
  if (nlen > 0 && nm[0] >= '0' && nm[0] <= '9') {
    say("A name can't start with a digit")
    return
  }
  if (nlen > 0 && name_taken()) {
    say("Another sprite already has that name")
    return
  }
  if (sslot < 0) {
    if (nlen == 0) {
      close_naming()
      return
    }
    rec[0] = tile % 256
    rec[1] = tile / 256
    rec[2] = 1
    rec[3] = 1
    writeasset(sh, rec, assetcount(sh))
    sslot = assetcount(sh) - 1
  }
  setassetname(sh, sslot, nm)
  copy(sname, nm)
  unsaved = 1
  if (nlen > 0) {
    fmt(msg, "Tile {tile} is Sprites.{nm}")
  } else {
    fmt(msg, "Name removed")
  }
  msgtime = 180
  close_naming()
}

fn name_key(k) {
  if (k < NCHARS) {
    if (nlen < 24) {
      nm[nlen] = CHARS[k]
      nlen++
      nm[nlen] = 0
    }
  } else if (k == NCHARS) {
    if (nlen > 0) {
      nlen--
      nm[nlen] = 0
    }
  } else {
    commit_name()
  }
}

fn name_input() {
  if (btnp(BTN_B)) {
    bused = 1
    close_naming()
    return
  }
  if (rp[BTN_LEFT])  { nsel = (nsel + NCELLS - 1) % NCELLS }
  if (rp[BTN_RIGHT]) { nsel = (nsel + 1) % NCELLS }
  if (rp[BTN_UP])    { nsel = (nsel + NCELLS - NCOLS) % NCELLS }
  if (rp[BTN_DOWN])  { nsel = (nsel + NCOLS) % NCELLS }
  if (btnp(BTN_A)) { name_key(nsel) }
  if (haspointer()) {
    var b = mouseb() & 1
    var pressed = b && !mprev
    mprev = b
    if (pressed) {
      var mx = mousex()
      var my = mousey()
      if (inside(mx, my, NPX + 6, NPY + 34, NCOLS * 20, 48)) {
        var k = (my - NPY - 34) / 12 * NCOLS + (mx - NPX - 6) / 20
        if (k < NCELLS) {
          nsel = k
          name_key(k)
        }
      }
    }
  }
}

// ---------- drawing on the tile ----------

fn setpx(x, y, c) {
  if (px[y * 8 + x] != c) {
    px[y * 8 + x] = c
    dirty = 1
    thumb = 1
  }
}

fn fill(x, y) {
  var target = px[y * 8 + x]
  if (target == colour) { return }
  var n = 1
  stk[0] = y * 8 + x
  px[y * 8 + x] = colour
  while (n > 0) {
    n--
    var p = stk[n]
    if (p % 8 > 0 && px[p - 1] == target) {
      px[p - 1] = colour
      stk[n] = p - 1
      n++
    }
    if (p % 8 < 7 && px[p + 1] == target) {
      px[p + 1] = colour
      stk[n] = p + 1
      n++
    }
    if (p >= 8 && px[p - 8] == target) {
      px[p - 8] = colour
      stk[n] = p - 8
      n++
    }
    if (p < 56 && px[p + 8] == target) {
      px[p + 8] = colour
      stk[n] = p + 8
      n++
    }
  }
  dirty = 1
  thumb = 1
}

fn begin() {
  if (tool != Tool.PICK) { copy(und, px) }
}

fn apply(x, y, pressed) {
  switch (tool) {
    Tool.PEN { setpx(x, y, colour) }
    Tool.FILL {
      if (pressed) { fill(x, y) }
    }
    Tool.PICK {
      if (pressed) {
        colour = px[y * 8 + x]
        tool = Tool.PEN
      }
    }
  }
}

fn undo() {
  copy(tmp, px)
  copy(px, und)
  copy(und, tmp)
  dirty = 1
  thumb = 1
}

// ---------- cart ----------

fn open() {
  var picked = pickcart("tiles")
  redraw_all = 1
  if (picked < 0) {
    say("No cart opened")
    return
  }
  h = picked
  sh = opensection(h, "sprites")
  cartname(h, title)
  tile = 0
  wx = 0
  wy = 0
  unsaved = 0
  load()
  fmt(msg, "Editing {assetcount(h)} tiles")
  msgtime = 180
}

fn save() {
  keep()
  if (savecart(h)) {
    unsaved = 0
    cartname(h, title)
    say("Saved")
  } else {
    say("Not saved")
  }
  redraw_all = 1
}

fn act(i) {
  if (i != 5) { open_armed = 0 }
  if (i < 3) {
    tool = i
    return
  }
  if (i == 3) {
    undo()
    return
  }
  if (i == 4) {
    open_naming()
    return
  }
  if (i == 5) {
    if ((unsaved || dirty) && !open_armed) {
      open_armed = 1
      fmt(msg, "Unsaved! OPEN again to discard")
      msgtime = 240
      return
    }
    open_armed = 0
    open()
    return
  }
  if (i == 6) {
    save()
    return
  }
  px[64] = px[64] ^ (1 << (i - NTOOLS))
  dirty = 1
}

// ---------- input ----------

fn rep(b) {
  if (btn(b)) {
    held[b]++
    return held[b] == 1 || (held[b] > 12 && held[b] % 4 == 0)
  }
  held[b] = 0
  return 0
}

fn navigate() {
  switch (focus) {
    Focus.CANVAS {
      if (rp[BTN_LEFT])  { cx = (cx + 7) % 8 }
      if (rp[BTN_RIGHT]) { cx = (cx + 1) % 8 }
      if (rp[BTN_UP])    { cy = (cy + 7) % 8 }
      if (rp[BTN_DOWN])  { cy = (cy + 1) % 8 }
      if (btnp(BTN_A)) { begin() }
      if (btn(BTN_A)) { apply(cx, cy, btnp(BTN_A)) }
    }
    Focus.SHEET {
      if (rp[BTN_LEFT])  { select(tile - 1) }
      if (rp[BTN_RIGHT]) { select(tile + 1) }
      if (rp[BTN_UP])    { select(tile - 32) }
      if (rp[BTN_DOWN])  { select(tile + 32) }
      if (btnp(BTN_A)) { focus = Focus.CANVAS }
    }
    Focus.PALETTE {
      if (rp[BTN_LEFT])  { colour = (colour + 15) % 16 }
      if (rp[BTN_RIGHT]) { colour = (colour + 1) % 16 }
      if (rp[BTN_UP] || rp[BTN_DOWN]) { colour = (colour + 8) % 16 }
      if (btnp(BTN_A)) { focus = Focus.CANVAS }
    }
    Focus.TOOLS {
      if (rp[BTN_LEFT])  { toolsel = (toolsel + NITEMS - 1) % NITEMS }
      if (rp[BTN_RIGHT]) { toolsel = (toolsel + 1) % NITEMS }
      if (rp[BTN_UP]) {
        if (toolsel >= NTOOLS) {
          toolsel = 4
        } else if (toolsel >= 4) {
          toolsel = toolsel - 4
        } else {
          toolsel = NTOOLS
        }
      }
      if (rp[BTN_DOWN]) {
        if (toolsel < 4) {
          toolsel = min(toolsel + 4, NTOOLS - 1)
        } else if (toolsel < NTOOLS) {
          toolsel = NTOOLS
        } else {
          toolsel = 0
        }
      }
      if (btnp(BTN_A)) { act(toolsel) }
    }
  }
}

fn inside(x, y, rx, ry, rw, rh) {
  return x >= rx && y >= ry && x < rx + rw && y < ry + rh
}

fn mouse() {
  if (!haspointer()) { return }
  var b = mouseb() & 1
  var pressed = b && !mprev
  mprev = b
  if (!b) { return }
  var mx = mousex()
  var my = mousey()
  if (inside(mx, my, CX, CY, 8 * Z, 8 * Z)) {
    cx = (mx - CX) / Z
    cy = (my - CY) / Z
    focus = Focus.CANVAS
    if (pressed) { begin() }
    apply(cx, cy, pressed)
    return
  }
  if (!pressed) { return }
  if (inside(mx, my, PALX, PALY, 88, 18)) {
    colour = (my - PALY) / 9 * 8 + (mx - PALX) / 11
    focus = Focus.PALETTE
  } else if (inside(mx, my, TOOLX, TOOLY, 4 * TOOLW, 26)) {
    var t = (my - TOOLY) / 13 * 4 + (mx - TOOLX) / TOOLW
    if (t < NTOOLS) {
      toolsel = t
      focus = Focus.TOOLS
      act(t)
    }
  } else if (inside(mx, my, FLAGX + 36, FLAGY, 80, 9)) {
    toolsel = NTOOLS + (mx - FLAGX - 36) / 10
    focus = Focus.TOOLS
    act(toolsel)
  } else if (inside(mx, my, SHX, SHY, SHCOLS * PITCH, SHROWS * PITCH)) {
    focus = Focus.SHEET
    select((wy + (my - SHY) / PITCH) * 32 + wx + (mx - SHX) / PITCH)
  } else if (inside(mx, my, 156, 128, 24, 11)) {
    scroll(-SHROWS, 0)
  } else if (inside(mx, my, 182, 128, 24, 11)) {
    scroll(SHROWS, 0)
  } else if (inside(mx, my, 208, 128, 24, 11)) {
    scroll(0, 1)
  }
}

// ---------- lifecycle ----------

init() {
  open()
}

update() {
  for (var b = 0; b < 4; b++) {
    rp[b] = rep(b)
  }
  if (msgtime > 0) { msgtime-- }
  if (h < 0) {
    if (btnp(BTN_A)) { open() }
    mouse()
    bdown = btn(BTN_B)
    return
  }
  if (naming) {
    name_input()
    bdown = btn(BTN_B)
    return
  }
  if (btn(BTN_B)) {
    if (btnp(BTN_B)) { bused = 0 }
    if (rp[BTN_LEFT]) {
      colour = (colour + 15) % 16
      bused = 1
    }
    if (rp[BTN_RIGHT]) {
      colour = (colour + 1) % 16
      bused = 1
    }
    if (rp[BTN_UP]) {
      select(tile - 1)
      bused = 1
    }
    if (rp[BTN_DOWN]) {
      select(tile + 1)
      bused = 1
    }
    if (btnp(BTN_A)) {
      undo()
      bused = 1
    }
  } else {
    if (bdown && !bused) { focus = (focus + 1) % 4 }
    navigate()
  }
  mouse()
  bdown = btn(BTN_B)
}

// ---------- drawing ----------

fn draw_tile(t, x, y) {
  if (t == tile) {
    for (var j = 0; j < 8; j++) {
      for (var i = 0; i < 8; i++) {
        pset(x + i, y + j, px[j * 8 + i])
      }
    }
  } else {
    rectfill(x, y, 8, 8, BLACK)
    drawasset(h, t, x, y)
  }
}

fn mark(t, c) {
  var col = t % 32 - wx
  var row = t / 32 - wy
  if (col >= 0 && col < SHCOLS && row >= 0 && row < SHROWS) {
    rect(SHX + col * PITCH - 1, SHY + row * PITCH - 1, 10, 10, c)
  }
}

fn draw_sheet() {
  rectfill(SHX - 2, SHY - 2, SHCOLS * PITCH + 3, SHROWS * PITCH + 3, BLACK)
  for (var r = 0; r < SHROWS; r++) {
    for (var c = 0; c < SHCOLS; c++) {
      draw_tile((wy + r) * 32 + wx + c, SHX + c * PITCH, SHY + r * PITCH)
    }
  }
  seldrawn = -1
  redraw_sheet = 0
  thumb = 0
}

fn draw_static() {
  cls(BG)
  rectfill(CX - 2, CY - 2, 8 * Z + 3, 8 * Z + 3, BLACK)
  print("COLOUR", PALX, PALY - 10, GREY)
  print("FLAGS", FLAGX, FLAGY + 1, GREY)
  rectfill(156, 128, 24, 11, DARK_GREY)
  rectfill(182, 128, 24, 11, DARK_GREY)
  rectfill(208, 128, 24, 11, DARK_GREY)
  print("UP", 162, 129, WHITE)
  print("DN", 188, 129, WHITE)
  print("<>", 214, 129, WHITE)
  redraw_sheet = 1
  redraw_all = 0
}

fn frame_around(x, y, w, hh, on) {
  rect(x, y, w, hh, on ? YELLOW : BG)
}

fn draw_naming(frame) {
  rectfill(NPX, NPY, 212, 90, BLACK)
  rect(NPX, NPY, 212, 90, YELLOW)
  print("NAME TILE {tile} AS A SPRITE", NPX + 6, NPY + 4, YELLOW)
  rectfill(NPX + 6, NPY + 16, 200, 11, DARK_GREY)
  var x = print("Sprites.", NPX + 9, NPY + 17, GREY)
  x = print(nm, x, NPY + 17, WHITE)
  if ((frame / 15) % 2 == 0) { rectfill(x, NPY + 17, 1, 8, WHITE) }
  for (var k = 0; k < NCELLS; k++) {
    var cx2 = NPX + 6 + (k % NCOLS) * 20
    var cy2 = NPY + 34 + (k / NCOLS) * 12
    var bg = DARK_GREY
    if (k >= NCHARS) { bg = BLUE }
    if (k == nsel) { bg = YELLOW }
    rectfill(cx2, cy2, 18, 10, bg)
    var fg = WHITE
    if (k == nsel) { fg = BLACK }
    if (k < NCHARS) {
      print("{CHARS[k]:c}", cx2 + 7, cy2 + 1, fg)
    } else if (k == NCHARS) {
      print("DEL", cx2 + 1, cy2 + 1, fg)
    } else {
      print("OK", cx2 + 4, cy2 + 1, fg)
    }
  }
}

draw(frame) {
  rectfill(0, 0, SCREEN_W, 11, BLACK)
  if (h < 0) {
    if (redraw_all) {
      cls(BG)
      redraw_all = 0
    }
    rectfill(0, 0, SCREEN_W, 11, BLACK)
    print("SPRITE EDITOR", 3, 1, YELLOW)
    rectfill(0, 60, SCREEN_W, 40, BG)
    print("Press A to open a cart", 54, 70, WHITE)
    if (msgtime > 0) {
      status(msg)
    } else {
      status("A: open a cart")
    }
    return
  }

  // top bar: which cart, which tile
  var tx0 = print("SPRITES", 3, 1, YELLOW)
  tx0 = print(title, tx0 + 6, 1, WHITE)
  if (unsaved || dirty) { print("*", tx0 + 2, 1, ORANGE) }
  print("TILE {tile:04}", 183, 1, WHITE)

  if (naming) {
    draw_naming(frame)
    if (msgtime > 0) {
      status(msg)
    } else {
      status("Arrows: letter  A: type  B: cancel")
    }
    return
  }

  if (redraw_all) { draw_static() }
  if (redraw_sheet) { draw_sheet() }
  if (thumb) {
    var col = tile % 32 - wx
    var row = tile / 32 - wy
    if (col >= 0 && col < SHCOLS && row >= 0 && row < SHROWS) {
      draw_tile(tile, SHX + col * PITCH, SHY + row * PITCH)
    }
    thumb = 0
  }

  // canvas: clear it first so the previous cursor outline disappears
  rectfill(CX - 1, CY - 1, 8 * Z + 1, 8 * Z + 1, BLACK)
  for (var y = 0; y < 8; y++) {
    for (var x = 0; x < 8; x++) {
      rectfill(CX + x * Z, CY + y * Z, Z - 1, Z - 1, px[y * 8 + x])
    }
  }
  var blink = (frame / 10) % 2 == 0
  if (focus == Focus.CANVAS && blink) {
    rect(CX + cx * Z - 1, CY + cy * Z - 1, Z + 1, Z + 1, WHITE)
  } else {
    rect(CX + cx * Z - 1, CY + cy * Z - 1, Z + 1, Z + 1, GREY)
  }
  frame_around(CX - 4, CY - 4, 8 * Z + 7, 8 * Z + 7, focus == Focus.CANVAS)

  // previews at 1x and 2x, sheet position and sprite name
  rectfill(PVX - 1, PVY - 1, 28, 18, BLACK)
  for (var y = 0; y < 8; y++) {
    for (var x = 0; x < 8; x++) {
      pset(PVX + x, PVY + y, px[y * 8 + x])
      rectfill(PVX + 10 + x * 2, PVY + y * 2, 2, 2, px[y * 8 + x])
    }
  }
  rectfill(134, 14, 104, 22, BG)
  print("Tile {tile % 32},{tile / 32}", 134, 15, GREY)
  if (sname[0] != 0) {
    print(sname, 134, 25, YELLOW)
  } else {
    print("no sprite name", 134, 25, DARK_GREY)
  }

  // palette
  for (var i = 0; i < 16; i++) {
    rectfill(PALX + (i % 8) * 11, PALY + (i / 8) * 9, 10, 8, i)
  }
  rect(PALX - 2, PALY - 2, 92, 22, BG)
  for (var i = 0; i < 16; i++) {
    if (i == colour) {
      rect(PALX + (i % 8) * 11 - 1, PALY + (i / 8) * 9 - 1, 12, 10, WHITE)
    } else {
      rect(PALX + (i % 8) * 11 - 1, PALY + (i / 8) * 9 - 1, 12, 10, BG)
    }
  }
  frame_around(PALX - 3, PALY - 3, 94, 24, focus == Focus.PALETTE)

  // tools
  for (var i = 0; i < NTOOLS; i++) {
    var tx = TOOLX + (i % 4) * TOOLW
    var ty = TOOLY + (i / 4) * 13
    var bg = DARK_GREY
    if (i < 3 && i == tool) { bg = BLUE }
    rectfill(tx, ty, TOOLW - 2, 11, bg)
    var fg = WHITE
    if (focus == Focus.TOOLS && toolsel == i) { fg = YELLOW }
    print(TOOL_NAMES[i], tx + 3, ty + 1, fg)
    if (focus == Focus.TOOLS && toolsel == i) {
      rect(tx - 1, ty - 1, TOOLW, 13, YELLOW)
    } else {
      rect(tx - 1, ty - 1, TOOLW, 13, BG)
    }
  }

  // flags
  for (var i = 0; i < 8; i++) {
    var fx = FLAGX + 36 + i * 10
    var on = (px[64] >> i) & 1
    rectfill(fx, FLAGY, 9, 9, on ? ORANGE : DARK_GREY)
    print("{i}", fx + 2, FLAGY, on ? BLACK : GREY)
    if (focus == Focus.TOOLS && toolsel == NTOOLS + i) {
      rect(fx - 1, FLAGY - 1, 11, 11, YELLOW)
    } else {
      rect(fx - 1, FLAGY - 1, 11, 11, BG)
    }
  }
  frame_around(TOOLX - 3, TOOLY - 3, 136, 45, focus == Focus.TOOLS)

  // sheet selection and info
  if (seldrawn != tile) {
    if (seldrawn >= 0) { mark(seldrawn, BLACK) }
    seldrawn = tile
  }
  if (focus == Focus.SHEET && blink) {
    mark(tile, YELLOW)
  } else {
    mark(tile, WHITE)
  }
  frame_around(SHX - 4, SHY - 4, SHCOLS * PITCH + 7, SHROWS * PITCH + 7, focus == Focus.SHEET)
  rectfill(156, 114, 80, 11, BG)
  print("ROWS {wy}-{wy + SHROWS - 1}", 156, 116, GREY)

  // the system status line shows hints and messages
  if (msgtime > 0) {
    status(msg)
  } else {
    switch (focus) {
      Focus.CANVAS { status("A draw  B tap: next panel  B+A undo") }
      Focus.SHEET { status("Arrows: tile   A: back to canvas") }
      Focus.PALETTE { status("Arrows: colour   A: back to canvas") }
      Focus.TOOLS { status("Arrows: choose   A: use   B: next") }
    }
  }
}
