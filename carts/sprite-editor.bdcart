// @title  Sprite Editor
// @author Bidule samples
// @id     sprite-editor

// Edits the tile sheet of a cart through the editing API, canvas first.
// Three panels: tools on the left, the sheet in the middle, colours on the right.
// B moves between panels, the arrows move inside the focused one and A acts.
// The mouse works everywhere: click to draw, pick and choose.
// Start opens the system menu (switch carts, volume, quit).

// panels
const P_TOOLS = 0
const P_VIEW = 1
const P_COLOURS = 2

// tools 0-8 stay selected; 9-14 act at once
const T_PEN = 0
const T_ERASE = 1
const T_FILL = 2
const T_PICK = 3
const T_LINE = 4
const T_RECT = 5
const T_SEL = 6
const T_MOVE = 7
const T_HAND = 8
const T_ZIN = 9
const T_ZOUT = 10
const T_UNDO = 11
const T_NAME = 12
const T_OPEN = 13
const T_SAVE = 14
const NT = 15
const NDRAW = 9

const TOOL_NAMES[15][3] = {
  "PEN",
  "ERA",
  "FIL",
  "PIK",
  "LIN",
  "REC",
  "SEL",
  "MOV",
  "HND",
  "Z+ ",
  "Z- ",
  "UND",
  "NAM",
  "OPN",
  "SAV",
}

// layout
const VX = 24
const VY = 3
const VWP = 192
const VHP = 144
const TBX = 1
const TBY = 3
const TBW = 21
const TBP = 9
const CLX = 219
const CLY = 3
const CLW = 20
const CLH = 8
const CLP = 9
const BG = DARK_BLUE

// zoom levels: 0 is the tile overview, the others edit pixels
const NZ = 5
const MAXSEL = 16
const NNAME = 37
const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
const NCELLS = 39
const NPX = 14
const NPY = 22
const NCOLS = 10

var h = -1
var sh = -1
var ro = 0
var title[17]
var tile = 0
var tool = 0
var lasttool = 0
var toolsel = 0
var colour = 7
var focus = P_VIEW

// view: the cursor and the part of the sheet shown (in pixels)
var cx = 0
var cy = 0
var vx = 0
var vy = 0
var vw = 16
var vh = 12
var zi = 3
var z = 12

// the tiles under the view, up to 5x4, kept in RAM while editing
var win[1300]
var wdirty[20]
var wtx = 0
var wty = 0
var wtw = 0
var wth = 0
var wvalid = 0
var tb[65]
var tc[65]

// undo: the tiles changed by the last action
var ulog_id[20]
var ulog_d[1280]
var ulog_n = 0

// tool state
var stroke = 0
var mdrag = 0
var lastx = 0
var lasty = 0
var anchor = 0
var ax = 0
var ay = 0
var sel_on = 0
var selecting = 0
var sx0 = 0
var sy0 = 0
var sx1 = 0
var sy1 = 0
var fl_on = 0
var flx = 0
var fly = 0
var flw = 0
var flh = 0
var fl[256]
var stk[384]
var sn = 0
var plot_mode = 0
var pcol = 0

var unsaved = 0
var open_armed = 0
var held[4]
var rp[4]
var mprev = 0
var redraw_all = 1
var redraw_view = 1
var msg[48]
var hint[48]
var msgtime = 0

// sprite name of the tile under the cursor
var sslot = -1
var sname[25]
var other[25]
var rec[4]

// name panel
var naming = 0
var nm[25]
var nlen = 0
var nsel = 0

// ---------- messages ----------

fn say(text[]) {
  copy(msg, text)
  msgtime = 180
}

// ---------- the tiles under the view ----------

fn zoom_of(i) {
  if (i == 0) { return 1 }
  if (i == 1) { return 6 }
  if (i == 2) { return 8 }
  if (i == 3) { return 12 }
  return 16
}

fn slot(tx, ty) {
  if (tx < wtx || ty < wty || tx >= wtx + wtw || ty >= wty + wth) { return -1 }
  return (ty - wty) * wtw + (tx - wtx)
}

// writes the changed tiles back to the cart's sheet
fn flush_win() {
  var n = wtw * wth
  for (var k = 0; k < n; k++) {
    if (wdirty[k]) {
      var t = (wty + k / wtw) * 32 + wtx + k % wtw
      for (var i = 0; i < 65; i++) {
        tb[i] = win[k * 65 + i]
      }
      writeasset(h, tb, t)
      wdirty[k] = 0
      unsaved = 1
    }
  }
}

fn load_win() {
  flush_win()
  if (zi == 0) {
    wtw = 0
    wth = 0
    wvalid = 0
    return
  }
  var tx0 = vx / 8
  var ty0 = vy / 8
  var tw = (vx + vw - 1) / 8 - tx0 + 1
  var th = (vy + vh - 1) / 8 - ty0 + 1
  if (wvalid && tx0 == wtx && ty0 == wty && tw == wtw && th == wth) { return }
  wtx = tx0
  wty = ty0
  wtw = tw
  wth = th
  for (var k = 0; k < tw * th; k++) {
    readasset(h, tb, (wty + k / wtw) * 32 + wtx + k % wtw)
    for (var i = 0; i < 65; i++) {
      win[k * 65 + i] = tb[i]
    }
    wdirty[k] = 0
  }
  wvalid = 1
}

// pixel of the sheet, or -1 outside the loaded tiles
fn getpx(x, y) {
  if (x < 0 || y < 0 || x > 255 || y > 255) { return -1 }
  var k = slot(x / 8, y / 8)
  if (k < 0) { return -1 }
  return win[k * 65 + (y % 8) * 8 + x % 8]
}

fn log_tile(t, k) {
  for (var i = 0; i < ulog_n; i++) {
    if (ulog_id[i] == t) { return }
  }
  if (ulog_n >= 20) { return }
  ulog_id[ulog_n] = t
  for (var i = 0; i < 64; i++) {
    ulog_d[ulog_n * 64 + i] = win[k * 65 + i]
  }
  ulog_n++
}

fn setpx(x, y, c) {
  if (x < 0 || y < 0 || x > 255 || y > 255) { return }
  var k = slot(x / 8, y / 8)
  if (k < 0) { return }
  var i = k * 65 + (y % 8) * 8 + x % 8
  if (win[i] == c) { return }
  log_tile((y / 8) * 32 + x / 8, k)
  win[i] = c
  wdirty[k] = 1
  redraw_view = 1
}

// the next action starts a new undo step
fn begin_op() {
  ulog_n = 0
}

// swaps the logged tiles with the sheet: undo twice is redo
fn undo() {
  flush_win()
  if (ulog_n == 0) {
    say("Nothing to undo")
    return
  }
  for (var n = 0; n < ulog_n; n++) {
    readasset(h, tb, ulog_id[n])
    for (var i = 0; i < 64; i++) {
      tc[i] = ulog_d[n * 64 + i]
      ulog_d[n * 64 + i] = tb[i]
    }
    tc[64] = tb[64]
    writeasset(h, tc, ulog_id[n])
  }
  unsaved = 1
  wvalid = 0
  load_win()
  redraw_view = 1
  say("Undo")
}

// ---------- drawing tools ----------

fn can_edit() {
  if (ro) {
    say("Read only: not allowed to edit")
    return 0
  }
  return 1
}

// plot_mode 0 changes the sheet, 1 only outlines the pixels in the view
fn put(x, y) {
  if (plot_mode == 0) {
    setpx(x, y, pcol)
  } else if (x >= vx && y >= vy && x < vx + vw && y < vy + vh) {
    rect(VX + (x - vx) * z, VY + (y - vy) * z, z, z, YELLOW)
  }
}

fn plot_line(x0, y0, x1, y1) {
  var dx = abs(x1 - x0)
  var dy = -abs(y1 - y0)
  var sx = 1
  if (x0 > x1) { sx = -1 }
  var sy = 1
  if (y0 > y1) { sy = -1 }
  var e = dx + dy
  for (var n = 0; n < 600; n++) {
    put(x0, y0)
    if (x0 == x1 && y0 == y1) { return }
    var e2 = 2 * e
    if (e2 >= dy) {
      e += dy
      x0 += sx
    }
    if (e2 <= dx) {
      e += dx
      y0 += sy
    }
  }
}

fn plot_rect(x0, y0, x1, y1) {
  var a = min(x0, x1)
  var b = max(x0, x1)
  var c = min(y0, y1)
  var d = max(y0, y1)
  for (var x = a; x <= b; x++) {
    put(x, c)
    put(x, d)
  }
  for (var y = c; y <= d; y++) {
    put(a, y)
    put(b, y)
  }
}

fn fill_push(x, y, target) {
  if (sn < 384 && getpx(x, y) == target) {
    setpx(x, y, colour)
    stk[sn] = y * 256 + x
    sn++
  }
}

// flood fill inside the loaded tiles
fn flood(x, y) {
  var target = getpx(x, y)
  if (target < 0 || target == colour) { return }
  sn = 0
  fill_push(x, y, target)
  while (sn > 0) {
    sn--
    var p = stk[sn]
    var qx = p % 256
    var qy = p / 256
    fill_push(qx - 1, qy, target)
    fill_push(qx + 1, qy, target)
    fill_push(qx, qy - 1, target)
    fill_push(qx, qy + 1, target)
  }
}

fn set_sel(x0, y0, x1, y1) {
  sx0 = min(x0, x1)
  sy0 = min(y0, y1)
  sx1 = max(x0, x1)
  sy1 = max(y0, y1)
  sel_on = 1
}

// lifts the selection into a floating copy that moves with the cursor
fn lift() {
  if (!sel_on) {
    say("Select first with SEL")
    return
  }
  if (sx0 < vx || sy0 < vy || sx1 >= vx + vw || sy1 >= vy + vh) {
    say("Selection is off screen: zoom out")
    return
  }
  begin_op()
  flw = sx1 - sx0 + 1
  flh = sy1 - sy0 + 1
  for (var j = 0; j < flh; j++) {
    for (var i = 0; i < flw; i++) {
      fl[j * flw + i] = getpx(sx0 + i, sy0 + j)
      setpx(sx0 + i, sy0 + j, 0)
    }
  }
  flx = sx0
  fly = sy0
  cx = flx
  cy = fly
  fl_on = 1
  redraw_view = 1
  say("Lifted: arrows move, A drops")
}

fn drop() {
  if (!fl_on) { return }
  for (var j = 0; j < flh; j++) {
    for (var i = 0; i < flw; i++) {
      var c = fl[j * flw + i]
      if (c != 0) { setpx(flx + i, fly + j, c) }
    }
  }
  set_sel(flx, fly, flx + flw - 1, fly + flh - 1)
  fl_on = 0
  redraw_view = 1
}

// ---------- the view ----------

fn follow() {
  if (zi == 0) {
    if (cx < vx) { vx = cx }
    if (cx >= vx + vw) { vx = cx - vw + 8 }
    if (cy < vy) { vy = cy }
    if (cy >= vy + vh) { vy = cy - vh + 8 }
    vx = clamp(vx, 0, 64)
    vy = clamp(vy, 0, 112)
  } else {
    var mx = min(2, vw / 4)
    var my = min(2, vh / 4)
    if (cx < vx + mx) { vx = cx - mx }
    if (cx > vx + vw - 1 - mx) { vx = cx - vw + 1 + mx }
    if (cy < vy + my) { vy = cy - my }
    if (cy > vy + vh - 1 - my) { vy = cy - vh + 1 + my }
    vx = clamp(vx, 0, 256 - vw)
    vy = clamp(vy, 0, 256 - vh)
  }
  load_win()
  redraw_view = 1
}

fn zoom_say() {
  if (zi == 0) {
    say("Overview: arrows move by tile, A zooms in")
  } else {
    fmt(msg, "Zoom x{z}")
    msgtime = 90
  }
}

fn set_zoom(n) {
  n = clamp(n, 0, NZ - 1)
  if (n == zi) {
    zoom_say()
    return
  }
  var was = zi
  zi = n
  z = zoom_of(n)
  vw = VWP / z
  vh = VHP / z
  if (zi == 0) {
    cx = cx / 8 * 8
    cy = cy / 8 * 8
    vx = clamp(cx - 96, 0, 64) / 8 * 8
    vy = clamp(cy - 72, 0, 112) / 8 * 8
  } else {
    if (was == 0) {
      cx += 4
      cy += 4
    }
    vx = clamp(cx - vw / 2, 0, 256 - vw)
    vy = clamp(cy - vh / 2, 0, 256 - vh)
  }
  load_win()
  redraw_view = 1
  zoom_say()
}

// moves the cursor (or the floating selection, or the view with HAND)
fn move_cursor(dx, dy) {
  if (zi == 0) {
    cx = clamp(cx + dx * 8, 0, 248)
    cy = clamp(cy + dy * 8, 0, 248)
    follow()
    return
  }
  if (tool == T_HAND && !fl_on) {
    vx = clamp(vx + dx * 4, 0, 256 - vw)
    vy = clamp(vy + dy * 4, 0, 256 - vh)
    cx = clamp(cx, vx, vx + vw - 1)
    cy = clamp(cy, vy, vy + vh - 1)
    load_win()
    redraw_view = 1
    return
  }
  if (fl_on) {
    var fx = flx + dx
    var fy = fly + dy
    if (fx >= vx && fy >= vy && fx + flw <= vx + vw && fy + flh <= vy + vh) {
      flx = fx
      fly = fy
      cx = fx
      cy = fy
      redraw_view = 1
    }
    return
  }
  var nx = clamp(cx + dx, 0, 255)
  var ny = clamp(cy + dy, 0, 255)
  if (selecting && (abs(nx - ax) >= MAXSEL || abs(ny - ay) >= MAXSEL)) { return }
  cx = nx
  cy = ny
  if (selecting) { set_sel(ax, ay, cx, cy) }
  if (stroke && btn(BTN_A)) {
    plot_mode = 0
    pcol = colour
    if (tool == T_ERASE) { pcol = 0 }
    plot_line(lastx, lasty, cx, cy)
    lastx = cx
    lasty = cy
  }
  follow()
}

fn use_tool(i) {
  if (fl_on && i != T_MOVE) { drop() }
  if (i == T_PICK && tool != T_PICK) { lasttool = tool }
  tool = i
  anchor = 0
  selecting = 0
  redraw_view = 1
}

// A in the view
fn press() {
  if (zi == 0) {
    set_zoom(3)
    return
  }
  if (tool == T_PEN || tool == T_ERASE) {
    if (!can_edit()) { return }
    begin_op()
    stroke = 1
    lastx = cx
    lasty = cy
    pcol = colour
    if (tool == T_ERASE) { pcol = 0 }
    plot_mode = 0
    setpx(cx, cy, pcol)
  } else if (tool == T_FILL) {
    if (!can_edit()) { return }
    begin_op()
    flood(cx, cy)
  } else if (tool == T_PICK) {
    var c = getpx(cx, cy)
    if (c >= 0) { colour = c }
    tool = lasttool
    fmt(msg, "Colour {colour}")
    msgtime = 90
  } else if (tool == T_LINE || tool == T_RECT) {
    if (!anchor) {
      anchor = 1
      ax = cx
      ay = cy
      say("A again for the end point")
    } else {
      if (!can_edit()) { return }
      begin_op()
      plot_mode = 0
      pcol = colour
      if (tool == T_LINE) {
        plot_line(ax, ay, cx, cy)
      } else {
        plot_rect(ax, ay, cx, cy)
      }
      anchor = 0
    }
  } else if (tool == T_SEL) {
    if (!selecting) {
      selecting = 1
      ax = cx
      ay = cy
      set_sel(cx, cy, cx, cy)
      say("Arrows grow it, A ends (max 16x16)")
    } else {
      selecting = 0
      fmt(msg, "Selected {sx1 - sx0 + 1}x{sy1 - sy0 + 1}")
      msgtime = 90
    }
  } else if (tool == T_MOVE) {
    if (fl_on) {
      drop()
      say("Dropped")
    } else {
      if (!can_edit()) { return }
      lift()
    }
  }
  redraw_view = 1
}

// ---------- sprites: a name for the tile under the cursor ----------

fn find_sprite() {
  sslot = -1
  sname[0] = 0
  var n = assetcount(sh)
  for (var i = 0; i < n; i++) {
    if (readasset(sh, rec, i) == 4) {
      if (rec[0] + rec[1] * 256 == tile && rec[2] == 1 && rec[3] == 1) {
        sslot = i
        assetname(sh, i, sname)
        return
      }
    }
  }
}

fn name_taken() {
  var n = assetcount(sh)
  for (var i = 0; i < n; i++) {
    if (i != sslot) {
      assetname(sh, i, other)
      if (streq(other, nm)) { return 1 }
    }
  }
  return 0
}

fn open_naming() {
  if (!can_edit()) { return }
  tile = (cy / 8) * 32 + cx / 8
  find_sprite()
  copy(nm, sname)
  nlen = 0
  while (nm[nlen] != 0) { nlen++ }
  nsel = 0
  naming = 1
}

fn close_naming() {
  naming = 0
  redraw_all = 1
}

fn commit_name() {
  if (nlen > 0 && nm[0] >= '0' && nm[0] <= '9') {
    say("A name can't start with a digit")
    return
  }
  if (nlen > 0 && name_taken()) {
    say("Another sprite already has that name")
    return
  }
  if (sslot < 0) {
    if (nlen == 0) {
      close_naming()
      return
    }
    rec[0] = tile % 256
    rec[1] = tile / 256
    rec[2] = 1
    rec[3] = 1
    writeasset(sh, rec, assetcount(sh))
    sslot = assetcount(sh) - 1
  }
  setassetname(sh, sslot, nm)
  unsaved = 1
  if (nlen > 0) {
    fmt(msg, "Tile {tile} is Sprites.{nm}")
  } else {
    fmt(msg, "Name removed")
  }
  msgtime = 180
  close_naming()
}

fn name_key(k) {
  if (k < NNAME) {
    if (nlen < 24) {
      nm[nlen] = CHARS[k]
      nlen++
      nm[nlen] = 0
    }
  } else if (k == NNAME) {
    if (nlen > 0) {
      nlen--
      nm[nlen] = 0
    }
  } else {
    commit_name()
  }
}

fn name_input() {
  if (btnp(BTN_B)) {
    close_naming()
    return
  }
  if (rp[BTN_LEFT])  { nsel = (nsel + NCELLS - 1) % NCELLS }
  if (rp[BTN_RIGHT]) { nsel = (nsel + 1) % NCELLS }
  if (rp[BTN_UP])    { nsel = (nsel + NCELLS - NCOLS) % NCELLS }
  if (rp[BTN_DOWN])  { nsel = (nsel + NCOLS) % NCELLS }
  if (btnp(BTN_A)) { name_key(nsel) }
  if (haspointer()) {
    var b = mouseb() & 1
    var pressed = b && !mprev
    mprev = b
    if (pressed) {
      var mx = mousex()
      var my = mousey()
      if (inside(mx, my, NPX + 6, NPY + 34, NCOLS * 20, 48)) {
        var k = (my - NPY - 34) / 12 * NCOLS + (mx - NPX - 6) / 20
        if (k < NCELLS) {
          nsel = k
          name_key(k)
        }
      }
    }
  }
}

// ---------- cart ----------

// Opens the current project (or asks which cart) and asks to be allowed to edit it.
fn open(ask) {
  var picked = -1
  if (!ask) { picked = opencart(-1, "tiles") }
  if (picked < 0) { picked = pickcart("tiles") }
  redraw_all = 1
  if (picked < 0) {
    say("No cart opened")
    return
  }
  h = picked
  ro = 0
  if (!requestwrite(h)) { ro = 1 }
  sh = opensection(h, "sprites")
  cartname(h, title)
  cx = 0
  cy = 0
  unsaved = 0
  ulog_n = 0
  wvalid = 0
  fl_on = 0
  sel_on = 0
  selecting = 0
  anchor = 0
  stroke = 0
  zi = 3
  z = 12
  vw = VWP / z
  vh = VHP / z
  vx = 0
  vy = 0
  load_win()
  redraw_view = 1
  if (ro) {
    say("Opened read only")
  } else {
    say("Editing")
  }
}

fn save() {
  if (!can_edit()) { return }
  flush_win()
  if (savecart(h)) {
    unsaved = 0
    cartname(h, title)
    say("Saved")
  } else {
    say("Not saved")
  }
  redraw_all = 1
}

fn act(i) {
  if (i != T_OPEN) { open_armed = 0 }
  if (i < NDRAW) {
    use_tool(i)
    return
  }
  if (i == T_ZIN) {
    set_zoom(zi + 1)
  } else if (i == T_ZOUT) {
    set_zoom(zi - 1)
  } else if (i == T_UNDO) {
    if (can_edit()) { undo() }
  } else if (i == T_NAME) {
    open_naming()
  } else if (i == T_OPEN) {
    flush_win()
    if (unsaved && !open_armed) {
      open_armed = 1
      say("Unsaved! OPN again to discard")
      return
    }
    open_armed = 0
    open(1)
  } else if (i == T_SAVE) {
    save()
  }
}

// ---------- input ----------

fn rep(b) {
  if (btn(b)) {
    held[b]++
    return held[b] == 1 || (held[b] > 12 && held[b] % 4 == 0)
  }
  held[b] = 0
  return 0
}

fn navigate() {
  var dx = 0
  var dy = 0
  if (rp[BTN_LEFT])  { dx = -1 }
  if (rp[BTN_RIGHT]) { dx = 1 }
  if (rp[BTN_UP])    { dy = -1 }
  if (rp[BTN_DOWN])  { dy = 1 }
  if (focus == P_VIEW) {
    if (dx != 0 || dy != 0) { move_cursor(dx, dy) }
    if (btnp(BTN_A)) { press() }
    if (!btn(BTN_A) && !mdrag) { stroke = 0 }
  } else if (focus == P_TOOLS) {
    if (dy != 0) { toolsel = (toolsel + NT + dy) % NT }
    if (btnp(BTN_A)) {
      act(toolsel)
      if (toolsel < NDRAW) { focus = P_VIEW }
    }
  } else {
    if (dy != 0) { colour = (colour + 16 + dy) % 16 }
    if (dx != 0) { colour = (colour + 16 + dx * 8) % 16 }
    if (btnp(BTN_A)) { focus = P_VIEW }
  }
}

fn inside(x, y, rx, ry, rw, rh) {
  return x >= rx && y >= ry && x < rx + rw && y < ry + rh
}

fn mouse() {
  if (!haspointer()) { return }
  var b = mouseb() & 1
  var pressed = b && !mprev
  mprev = b
  if (!b) {
    if (mdrag) {
      mdrag = 0
      stroke = 0
    }
    return
  }
  var mx = mousex()
  var my = mousey()
  if (inside(mx, my, VX, VY, VWP, VHP)) {
    var nx = vx + (mx - VX) / z
    var ny = vy + (my - VY) / z
    if (zi == 0) {
      nx = nx / 8 * 8
      ny = ny / 8 * 8
    }
    if (pressed) {
      cx = nx
      cy = ny
      focus = P_VIEW
      redraw_view = 1
      press()
      mdrag = stroke
    } else if (mdrag && (nx != cx || ny != cy)) {
      cx = nx
      cy = ny
      plot_mode = 0
      pcol = colour
      if (tool == T_ERASE) { pcol = 0 }
      plot_line(lastx, lasty, cx, cy)
      lastx = cx
      lasty = cy
      redraw_view = 1
    }
    return
  }
  if (!pressed) { return }
  if (inside(mx, my, TBX, TBY, TBW, NT * TBP)) {
    toolsel = (my - TBY) / TBP
    act(toolsel)
    focus = P_VIEW
  } else if (inside(mx, my, CLX, CLY, CLW, 16 * CLP)) {
    colour = (my - CLY) / CLP
    focus = P_VIEW
    redraw_view = 1
  }
}

// ---------- lifecycle ----------

init() {
  open(0)
}

update() {
  for (var b = 0; b < 4; b++) {
    rp[b] = rep(b)
  }
  if (msgtime > 0) { msgtime-- }
  if (h < 0) {
    if (btnp(BTN_A)) { open(0) }
    return
  }
  if (naming) {
    name_input()
    return
  }
  if (btnp(BTN_B)) {
    focus = (focus + 1) % 3
    redraw_view = 1
  } else {
    navigate()
  }
  mouse()
  flush_win()
}

// ---------- drawing ----------

fn draw_overview() {
  rectfill(VX, VY, VWP, VHP, BLACK)
  var t0 = (vy / 8) * 32 + vx / 8
  for (var j = 0; j < 18; j++) {
    for (var i = 0; i < 24; i++) {
      drawasset(h, t0 + j * 32 + i, VX + i * 8, VY + j * 8)
    }
  }
  if (sel_on) {
    rect(VX + sx0 - vx, VY + sy0 - vy, sx1 - sx0 + 1, sy1 - sy0 + 1, YELLOW)
  }
  var edge = GREY
  if (focus == P_VIEW) { edge = WHITE }
  rect(VX + cx - vx - 1, VY + cy - vy - 1, 10, 10, edge)
}

fn draw_view() {
  if (zi == 0) {
    draw_overview()
    return
  }
  var pad = 0
  if (z >= 8) { pad = 1 }
  rectfill(VX, VY, VWP, VHP, BG)
  for (var j = 0; j < vh; j++) {
    for (var i = 0; i < vw; i++) {
      var c = getpx(vx + i, vy + j)
      if (c <= 0) {
        c = BLACK
        if ((vx + i + vy + j) % 2 == 0) { c = DARK_GREY }
      }
      rectfill(VX + i * z, VY + j * z, z - pad, z - pad, c)
    }
  }
  if (fl_on) {
    for (var j = 0; j < flh; j++) {
      for (var i = 0; i < flw; i++) {
        var c = fl[j * flw + i]
        if (c != 0) {
          rectfill(VX + (flx + i - vx) * z, VY + (fly + j - vy) * z, z - pad, z - pad, c)
        }
      }
    }
  }
  if (sel_on) {
    rect(VX + (sx0 - vx) * z - 1, VY + (sy0 - vy) * z - 1, (sx1 - sx0 + 1) * z + 1, (sy1 - sy0 + 1) * z + 1, YELLOW)
  }
  if (anchor) {
    plot_mode = 1
    if (tool == T_LINE) {
      plot_line(ax, ay, cx, cy)
    } else {
      plot_rect(ax, ay, cx, cy)
    }
    plot_mode = 0
  }
  var edge = GREY
  if (focus == P_VIEW) { edge = WHITE }
  rect(VX + (cx - vx) * z - 1, VY + (cy - vy) * z - 1, z + 1, z + 1, edge)
}

fn frame_around(x, y, w, hh, on) {
  rect(x, y, w, hh, on ? YELLOW : BG)
}

fn draw_ui() {
  for (var i = 0; i < NT; i++) {
    var y = TBY + i * TBP
    var bg = DARK_GREY
    if (i == tool) { bg = BLUE }
    rectfill(TBX, y, TBW, TBP - 1, bg)
    var fg = WHITE
    if (focus == P_TOOLS && i == toolsel) { fg = YELLOW }
    print(TOOL_NAMES[i], TBX + 2, y - 1, fg)
  }
  rect(TBX - 1, TBY - 1, TBW + 2, NT * TBP + 1, focus == P_TOOLS ? YELLOW : BG)
  if (focus == P_TOOLS) {
    rect(TBX, TBY + toolsel * TBP - 1, TBW, TBP + 1, YELLOW)
  }
  for (var i = 0; i < 16; i++) {
    var y = CLY + i * CLP
    rectfill(CLX, y, CLW, CLH, i)
    rect(CLX - 1, y - 1, CLW + 2, CLH + 2, i == colour ? WHITE : BG)
  }
  rect(CLX - 2, CLY - 2, CLW + 4, 16 * CLP + 2, focus == P_COLOURS ? YELLOW : BG)
}

fn draw_naming(frame) {
  rectfill(NPX, NPY, 212, 90, BLACK)
  rect(NPX, NPY, 212, 90, YELLOW)
  print("NAME TILE {tile} AS A SPRITE", NPX + 6, NPY + 4, YELLOW)
  rectfill(NPX + 6, NPY + 16, 200, 11, DARK_GREY)
  var x = print("Sprites.", NPX + 9, NPY + 17, GREY)
  x = print(nm, x, NPY + 17, WHITE)
  if ((frame / 15) % 2 == 0) { rectfill(x, NPY + 17, 1, 8, WHITE) }
  for (var k = 0; k < NCELLS; k++) {
    var cx2 = NPX + 6 + (k % NCOLS) * 20
    var cy2 = NPY + 34 + (k / NCOLS) * 12
    var bg = DARK_GREY
    if (k >= NNAME) { bg = BLUE }
    if (k == nsel) { bg = YELLOW }
    rectfill(cx2, cy2, 18, 10, bg)
    var fg = WHITE
    if (k == nsel) { fg = BLACK }
    if (k < NNAME) {
      print("{CHARS[k]:c}", cx2 + 7, cy2 + 1, fg)
    } else if (k == NNAME) {
      print("DEL", cx2 + 1, cy2 + 1, fg)
    } else {
      print("OK", cx2 + 4, cy2 + 1, fg)
    }
  }
}

draw(frame) {
  if (h < 0) {
    cls(BG)
    rectfill(0, 0, SCREEN_W, 11, BLACK)
    print("SPRITE EDITOR", 3, 1, YELLOW)
    print("Press A to open a cart", 54, 70, WHITE)
    if (msgtime > 0) {
      status(msg)
    } else {
      status("A: open a cart")
    }
    return
  }

  if (naming) {
    draw_naming(frame)
    if (msgtime > 0) {
      status(msg)
    } else {
      status("Arrows: letter  A: type  B: cancel")
    }
    return
  }

  if (redraw_all) {
    cls(BG)
    redraw_all = 0
    redraw_view = 1
  }
  if (redraw_view) {
    draw_view()
    redraw_view = 0
  }
  draw_ui()

  // the system status line shows messages and hints
  if (msgtime > 0) {
    status(msg)
  } else if (focus == P_VIEW) {
    fmt(hint, "{TOOL_NAMES[tool]} {cx},{cy}  A use  B panel")
    status(hint)
  } else if (focus == P_TOOLS) {
    status("Up/down: tool   A: use   B: next panel")
  } else {
    status("Arrows: colour   A: done   B: next panel")
  }
}
